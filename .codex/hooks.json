{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/ai/hooks/block-commit-attribution.cjs\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) 'ai/hooks/block-commit-attribution.cjs')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
