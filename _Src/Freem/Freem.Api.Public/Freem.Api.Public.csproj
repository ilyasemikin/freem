<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Freem.Domain\Freem.Domain.csproj"/>
        <ProjectReference Include="..\Freem.Domain.Serialization.Json\Freem.Domain.Serialization.Json.csproj"/>
        <ProjectReference Include="..\Freem.Domain.Storage.PostgreSQL\Freem.Domain.Storage.PostgreSQL.csproj"/>
        <ProjectReference Include="..\Freem.Domain.UseCases\Freem.Domain.UseCases.csproj"/>
        <ProjectReference Include="..\Freem.Locking.Redis\Freem.Locking.Redis.csproj"/>
        <ProjectReference Include="..\Freem.Time\Freem.Time.csproj"/>
        <ProjectReference Include="..\Freem.Api.Public.Contracts\Freem.Api.Public.Contracts.csproj"/>
        <ProjectReference Include="..\Freem.Api.Public.UseCases\Freem.Api.Public.UseCases.csproj"/>
        <ProjectReference Include="..\Freem.Api.Public.UseCases.Contracts\Freem.Api.Public.UseCases.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Configuration\DependencyInjection\Microsoft\"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Freem.Api.Public.IntegrationTests"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
      <PackageReference Include="Microsoft.OpenApi" Version="2.12.2"/>
      <PackageReference Include="Scalar.AspNetCore" Version="2.11.1" />
      <PackageReference Include="EgoHub.Api.Public.Client" Version="0.0.10"/>
      <PackageReference Include="EgoHub.Authentication.AspNetCore" Version="0.0.1"/>
      <PackageReference Include="Utilities.Clock" Version="0.1.0"/>
      <PackageReference Include="Utilities.Errors" Version="0.0.1"/>
      <PackageReference Include="Utilities.Errors.Serialization.Json" Version="0.0.1"/>
      <PackageReference Include="Utilities.UseCases" Version="0.1.0"/>
    </ItemGroup>

</Project>
