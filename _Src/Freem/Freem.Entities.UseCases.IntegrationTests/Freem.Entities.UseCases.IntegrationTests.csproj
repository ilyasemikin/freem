<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
        <PackageReference Include="Utilities.Clock" Version="0.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Freem.Domain\Freem.Domain.csproj"/>
        <ProjectReference Include="..\Freem.Entities.Events.Producer\Freem.Entities.Events.Producer.csproj" />
        <ProjectReference Include="..\Freem.Entities.Storage.PostgreSQL\Freem.Entities.Storage.PostgreSQL.csproj"/>
        <ProjectReference Include="..\Freem.Entities.UseCases.Contracts\Freem.Entities.UseCases.Contracts.csproj" />
        <ProjectReference Include="..\Freem.Entities.UseCases.Plain\Freem.Entities.UseCases.Plain.csproj" />
        <ProjectReference Include="..\Freem.Entities.UseCases\Freem.Entities.UseCases.csproj"/>
        <ProjectReference Include="..\Freem.Domain.Entities\Freem.Domain.Entities.csproj"/>
        <ProjectReference Include="..\Freem.Locking.Abstractions\Freem.Locking.Abstractions.csproj" />
        <ProjectReference Include="..\Freem.Results\Freem.Results.csproj" />
        <ProjectReference Include="..\Freem.Time\Freem.Time.csproj" />
        <ProjectReference Include="..\Freem.UseCases.Abstractions\Freem.UseCases.Abstractions.csproj" />
        <ProjectReference Include="..\Freem.UseCases.Contracts.Abstractions\Freem.UseCases.Contracts.Abstractions.csproj" />
    </ItemGroup>

    <Target Name="CopyConfiguration" BeforeTargets="BeforeBuild">
        <Copy SourceFiles="configuration.json" DestinationFolder="$(OutDir)"/>
    </Target>

</Project>
