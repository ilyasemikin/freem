COMPOSE_PROJECT_NAME=freem_service

POSTGRES_USER=
POSTGRES_PASSWORD=

# Required: existing Docker network shared with the separately managed reverse proxy
PROXY_NETWORK_NAME=

# EgoHub is an external service: its public API address as the API container sees it
# (e.g. http://host.docker.internal:<port>) and a service token in the form <KeyId>:<Value>
EGOHUB_INTEGRATION_URL=
EGOHUB_INTEGRATION_TOKEN=

# Addresses as the browser sees them
API_PUBLIC_URL=https://api.freem.example.com
WEB_PUBLIC_URL=https://freem.example.com
# Path prefix the web app is served under behind a reverse proxy that strips it (e.g. /freem/); defaults to /
WEB_BASE_PATH=/
